# FROM postgres:12.1-alpine
FROM postgres:17.5-alpine

RUN apk add --no-cache supervisor tzdata docker-cli
RUN mkdir /etc/supervisor.d
COPY postgres_cron.ini /etc/supervisor.d/postgres_cron.ini

# pgvector (2026-10-29, scoping for a possible float16 embedding-storage
# migration -- see CLAUDE.md). Built from source rather than switching to
# the official pgvector/pgvector image, which is Debian-based and would
# mean redoing all the alpine-specific infra above (supervisord, cron,
# docker-cli) on a different base. Verified in a standalone throwaway
# spike first: builds cleanly against this exact postgres:17.5-alpine's
# headers once the OPTIONAL LLVM JIT-bytecode step is skipped (with_llvm=
# no) -- that step failed on a clang major-version mismatch between
# alpine's packaged clang and what PGXS's JIT inlining expects; it's not
# needed for the extension to function, only for an unrelated JIT
# optimization.
RUN apk add --no-cache --virtual .pgvector-build-deps build-base postgresql-dev git \
    && git clone --branch v0.8.0 --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector \
    && make OPTFLAGS="" with_llvm=no \
    && make install with_llvm=no \
    && cd / && rm -rf /tmp/pgvector \
    && apk del .pgvector-build-deps

# Real, confirmed gotcha from the first real deploy of this (2026-10-29/
# 30, see CLAUDE.md and face_manager/migrations/0020's own header):
# `CREATE EXTENSION` needs superuser, but this project's app DB role
# (`benjamin`) deliberately ISN'T superuser in production -- so a Django
# migration running under that restricted role can NEVER create this
# extension itself, fresh database or not; it's not a one-time fluke.
# postgres_init_vector.sql runs automatically, as superuser, via the
# official postgres image's own /docker-entrypoint-initdb.d/*.sql
# convention, the FIRST time a fresh (empty) data directory is
# initialized -- covering a brand-new container AND a disaster-recovery
# restore into a fresh data directory (initdb, including this script,
# runs before pg_restore ever touches it) with zero manual steps. An
# ALREADY-initialized database doesn't get this re-run automatically and
# needs CREATE EXTENSION done once, by hand, as superuser (already done
# for db_picasa/db_picasa_dev as of this deploy).
COPY postgres_init_vector.sql /docker-entrypoint-initdb.d/

# TZ env var (set in docker-compose.yaml) needs tzdata installed to
# actually take effect -- without it, TZ is silently ignored and
# everything (including cron) stays on UTC.

# crontab_root is COPY'd (baked into the image), deliberately NOT
# bind-mounted like the scripts below. BusyBox crond silently ignores a
# crontab whose file owner doesn't match the target user (root, for
# /etc/crontabs/root) -- found 2026-09-01 the hard way: a bind mount
# preserves the HOST file's ownership (the host user, not root), so
# crond loaded fine but never actually ran a single scheduled job, with
# zero errors anywhere (this image has no syslog daemon for crond to
# report to even if it wanted to). COPY runs as root during the image
# build, so the file lands owned by root with no extra step -- and
# critically, chown'ing a bind-mounted file (which is what fixing this
# in place required) changes the HOST file's ownership too, since it's
# the same inode -- not something to solve by bind-mounting harder.
# Editing the crontab now needs a rebuild + `--force-recreate`, same
# tradeoff already accepted for postgres_cron.ini above.
COPY crontab_root /etc/crontabs/root

# postgres_bak.sh, prune_backups.py, and weekly_vacuum_swap.py are still
# bind-mounted (see docker-compose.yaml) -- their executable bits come
# from the host files themselves (preserved through the bind mount), so
# make sure they stay chmod +x on the host. Unlike the crontab, crond
# doesn't care about THEIR ownership -- it just execs whatever the
# crontab tells it to.

ENTRYPOINT ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
