# FROM debian:buster
FROM ubuntu:24.04
WORKDIR /code

RUN apt update

RUN apt install -y cmake python3-pip wget python3.12-venv \ 
    exiv2 gir1.2-gexiv2-0.10 libgirepository-1.0-1 \
    libffi-dev exempi python3-gi iputils-ping libgl1 curl
# RUN apt install python3.11-venv -y

# RUN python3 -m venv /code/venv
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
# RUN source picasa_env/bin/activate

# Add our requirements.txt
RUN pip3 install opencv-python-headless>=4.4.0.44 
#RUN pip3 install face_recognition 
#RUN pip3 install face-recognition-models==0.3.0
# RUN pip3 install facenet-pytorch==2.5.0   


ADD requirements.txt /code/requirements.txt
RUN pip3 install -r /code/requirements.txt 

RUN apt remove cmake -y

RUN cp /usr/bin/python3 /usr/bin/python

# RUN echo "deb http://apt.postgresql.org/pub/repos/apt/ precise-pgdg main" > /etc/apt/sources.list.d/pgdg.list
# RUN apt install -y gir1.2-gtk-3.0
# RUN apt install -y python3-gi-cairo 

# RUN pip3 install PyJWT==1.7.1

# RUN apt install -y postgresql
# Fresh `apt update` immediately before this install, not just relying on
# the one at the top of the file: Docker layer caching can reuse that
# early layer's package index long after the mirror has actually moved on
# (pruned an old package version), causing a 404 on a package that was
# resolvable when the early layer was last built. Hit this for real
# 2026-09-05 (libfdisk1's pinned version 404ing from security.ubuntu.com,
# unrelated to any Python dependency change) -- reproduced identically
# across multiple build attempts until this was added.
RUN apt update
RUN DEBIAN_FRONTEND=noninteractive apt install -y postgresql # postgresql-contrib
RUN rm -r /var/lib/apt/lists

# startup.sh is no longer baked into the image here -- it's part of the
# /code bind mount (see docker-compose.yaml's command, which now points at
# dockerize/startup.sh directly), so editing it takes effect on a plain
# container restart instead of requiring an image rebuild.

RUN groupadd --gid 1001 usergrp && useradd --uid 1001 --gid usergrp -m user

WORKDIR /code
